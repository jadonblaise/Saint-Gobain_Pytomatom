# -- GIT is ignoring --

# Production secrets
certificate.password
sharepoint.password.json
production.env
*.password
certificates/pytomatom.key

# Git itself
.git/

# Logs
**/logs/*.log

# Editor settings
.vscode/
.idea/

# Database
database/sqlite3.db
# don't ignore migrations
!**/migrations/__init__.py

# Environment
.env
.secretkey
# production.env, already ignored on-top
local.env
envs/*.env
.secrets/

# The venv is deployed to .venv/ in production, should not be part of the
# version control and could be purged or kept through releases.
.venv/

# Static files
staticfiles

# no trash please
trash/

# temporary files
temp/

# ===================
## Python
# ===================
__pycache__
*.py[cod]
# Keep keep.pyc to allow empty Django-template directories to be committed to git.
!**/keep.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# Jupyter
.ipynb_checkpoints/
.ipython/

# Tests
.coverage
.hypothesis/
htmlcov/


# ===================
## Tyepscript Frontend
# ===================
# TBD: You might want to gitignore the frontend explicitly
# (e.g. cloning from a different origin)
# frontend/
**/node_modules/
frontend/dist/
.env.production

# ignore the outputs of the automatom
outputs/

